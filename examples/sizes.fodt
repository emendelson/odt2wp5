  <style:style style:name="P12" style:family="paragraph"><style:text-properties style:font-name="Helvetica" fo:font-size="24pt"/></style:style>
 </office:automatic-styles>
 <office:body><office:text>
  <text:p text:style-name="P1">Times New Roman 8 point.</text:p>
  <text:p text:style-name="P2">Times New Roman 10 point.</text:p>
  <text:p text:style-name="P3">Times New Roman 12 point.</text:p>
  <text:p text:style-name="P4">Times New Roman 14 point.</text:p>
